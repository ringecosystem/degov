  "maintenance": {
    "ownerRepository": "ringecosystem/degov",
    "contractPath": "docs/spec/seo-geo-social-preview-contract.json",
    "localCheck": "pnpm run test:seo-geo-social-preview",
    "changeRule": "A fixture, platform, image rule, or completion claim may change only with an owner issue, repository follow-up, automated evidence, and #714-linked rationale."
  },
  "stagePlan": [
    {
      "id": "stable-baseline-assets",
      "status": "contracted",
      "scope": "Host-correct metadata, stable 1200x630 fallback images, raw-head extraction, public image fetch checks, and cache documentation for priority fixtures."
    },
    {
      "id": "bounded-entity-specific-assets",
      "status": "deferred-until-stage-1-stable",
      "scope": "DAO, proposal, Atlas DAO, and optional Docs page-specific share cards after fallback assets and validation are reliable."
    }
  ],
  "metadataContract": {
    "openGraphRequired": [
      "og:title",
      "og:type",
      "og:url",
      "og:image",
      "og:description",
      "og:site_name",
      "og:locale",
      "og:image:type",
      "og:image:width",
      "og:image:height",
      "og:image:alt"
    ],
    "twitterRequired": [
      "twitter:card",
      "twitter:title",
      "twitter:description",
      "twitter:image",
      "twitter:image:alt"
    ],
    "canonicalUrlRule": "The canonical URL, og:url, and Twitter page URL must resolve to the same validated production page origin and path.",
    "privateRouteRule": "Private, invalid, authenticated, write, preview, and staging routes must not emit convincing public share metadata and must not enter a public sitemap."
  },
  "imageSpec": {
    "primaryDimensions": {
      "width": 1200,
      "height": 630
    },
    "allowedMimeTypes": [
      "image/png",
      "image/jpeg",
      "image/webp"
    ],
    "requiredTransport": "absolute-https-public-200",
    "recommendedTwitterCard": "summary_large_image",
    "minimumCachePolicy": "Cache-Control must be explicit. Mutable dynamic cards require a cache-version strategy before including mutable status, vote totals, or proposal state.",
    "safeAreaRule": "Keep core title, DAO identity, and DeGov attribution within a centered 1000x500 safe area so platform crops remain readable.",
    "fallbackHierarchy": [
      "route-specific validated dynamic image",
      "surface-specific stable 1200x630 image",
      "DeGov-branded stable 1200x630 image"
    ],
    "dynamicInputRules": [
      "Escape all dynamic text before rendering.",
      "Bound title, DAO name, ENS, address, and locale strings before rendering.",
      "Do not fetch arbitrary user-provided image URLs.",
      "Do not include wallet addresses, private profile state, proposal drafts, authentication state, OAuth values, or unpublished proposal text.",
      "Do not include mutable proposal status, vote totals, quorum, or turnout unless cache invalidation is reliable and versioned."
    ],
    "textFixtureRequirements": [
      "long-dao-name",
      "long-proposal-title",
      "emoji",
      "ens-name",
      "ethereum-address",
      "non-latin-text"
    ]
  },
  "platforms": [
    {
      "id": "meta-facebook",
      "name": "Meta/Facebook Sharing Debugger",
      "verificationType": "manual-platform-readback",
      "requiredEvidence": [
