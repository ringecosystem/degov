  "metricGroups": [
    {
      "id": "canonical-indexing",
      "requiredFields": ["intendedCanonicalUrl", "indexedCanonicalUrl", "googleSelectedCanonicalUrl", "status", "lastObservedAt"],
      "interpretation": "Compare intended canonical URLs with indexed and selected canonicals by surface; do not count total indexed URLs as success by itself.",
      "privacyClass": "public-or-aggregate"
    },
    {
      "id": "sitemap-processing",
      "requiredFields": ["sitemapUrl", "submittedAt", "lastReadAt", "discoveredUrls", "indexedUrls", "errors"],
      "interpretation": "Record submitted, discovered, indexed, invalid, redirected, noindex, and wrong-host sitemap outcomes.",
      "privacyClass": "aggregate"
    },
    {
      "id": "query-landing-performance",
      "requiredFields": ["surface", "queryClass", "landingPage", "clicks", "impressions", "ctr", "qualifiedVisits", "trueReferrerState", "directOrUnknownVisits", "window"],
      "interpretation": "Separate branded and non-brand query coverage, qualified landing visits, and product outcomes where consented analytics exists; AI/social attribution requires a real referrer and must otherwise remain direct-or-unknown.",
      "privacyClass": "aggregate"
    },
    {
      "id": "crawl-errors",
      "requiredFields": ["surface", "host", "pathGroup", "crawlerPurpose", "identityVerification", "statusGroup", "errorType", "wafAction", "observationState", "count", "window"],
      "interpretation": "Track soft 404, duplicate, blocked, server-error, and currently-not-indexed groups by crawler purpose and verified identity without exposing raw private logs.",
      "privacyClass": "aggregate"
    },
    {
      "id": "field-cwv",
      "requiredFields": ["surface", "pageTemplate", "metric", "p75", "source", "window"],
      "interpretation": "Use field Core Web Vitals only where enough data exists; lab data must be labeled separately.",
      "privacyClass": "aggregate"
    },
    {
      "id": "bing-ai-performance",
      "requiredFields": ["surface", "availabilityState", "citationUrl", "groundingQuery", "window"],
      "interpretation": "Record Bing-supported AI Performance data where available; do not treat it as a universal GEO score.",
      "privacyClass": "aggregate"
    },
    {
      "id": "crawler-access-outcomes",
      "requiredFields": ["surface", "host", "crawlerPurpose", "identityVerification", "statusGroup", "wafAction", "cacheResult", "observationState", "count", "window"],
      "interpretation": "Report allowed, blocked, challenged, failed, and not-observed crawler outcomes by purpose and host; unverified User-Agent strings must remain unverified.",
      "privacyClass": "aggregate"
    },
    {
      "id": "referral-qualified-visits",
      "requiredFields": ["surface", "landingPage", "referrerClass", "trueReferrerState", "qualifiedVisits", "directOrUnknownVisits", "conversionEventState", "window"],
      "interpretation": "Attribute AI or social referral traffic only when a real referrer exists; unattributed visits remain direct-or-unknown and do not become AI/social referrals.",
      "privacyClass": "aggregate"
    }
  ],
  "crawlerLogSchema": {
    "requiredFields": ["timestamp", "host", "path", "status", "bytes", "latencyMs", "userAgent", "crawlerPurpose", "identityVerification", "cacheResult", "wafAction"],
    "optionalFields": ["refererHost", "country", "asn", "requestId", "sampleRate"],
    "privacyClass": "aggregate-or-sampled",
    "storageRule": "Do not commit raw private logs or exports; publish only aggregate reports or redacted samples.",
    "identityRule": "A claimed User-Agent alone is unverified. Verified crawler identity requires official IP/rDNS guidance or platform-provided verification."
  },
  "retentionPolicy": {
    "rawLogRetentionDays": 30,
    "aggregateRetentionDays": 395,
    "minimumAggregationFields": ["surface", "host", "pathGroup", "crawlerPurpose", "identityVerification", "statusGroup", "wafAction", "window"],
    "redactionRules": ["remove-request-id-before-publication", "remove-user-level-identifiers", "remove-wallet-addresses", "truncate-or-hash-paths-when-sensitive"],
    "samplingRule": "Raw samples may be kept only for operational debugging and must not be committed; published evidence must be aggregate or explicitly redacted.",
    "deletionRule": "Delete raw private logs after the retention window unless a security incident hold is approved."
  },
  "crawlerPurposes": [
    {
      "id": "search-index",
      "examples": ["Googlebot", "Bingbot"],
      "expectedTreatment": "Approved public content should be reachable unless route policy says otherwise."
    },
    {
      "id": "ai-search-reference",
      "examples": ["OAI-SearchBot", "Claude-SearchBot", "PerplexityBot"],
      "expectedTreatment": "Measure separately from training crawlers and preserve policy gaps."
    },
    {
      "id": "user-triggered-fetch",
      "examples": ["ChatGPT-User", "Claude-User", "Perplexity-User"],
      "expectedTreatment": "Classify separately from automatic indexing and training."
    },
    {
      "id": "model-training",
      "examples": ["GPTBot", "ClaudeBot"],
      "policyTokens": ["Google-Extended"],
      "expectedTreatment": "Observed access must be compared with the separate crawler policy issue before changing allow/deny behavior."
    },
    {
      "id": "social-preview",
      "examples": ["facebookexternalhit", "LinkedInBot", "Twitterbot", "Slackbot", "Discordbot", "TelegramBot"],
      "expectedTreatment": "Public pages and share assets should be fetchable when route policy approves sharing."
    },
    {
      "id": "normal-browser",
      "examples": ["Mozilla-compatible browser sessions"],
      "expectedTreatment": "Keep separate from crawler metrics and conversion reporting."
    }
  ],
  "changeAnnotationModel": {
    "requiredEvents": ["release", "sitemap-submission", "robots-change", "cdn-waf-change", "content-release", "crawler-policy-change", "experiment-start", "experiment-stop"],
    "requiredFields": ["eventId", "date", "surface", "eventType", "owner", "summary", "links"],
    "comparisonWindowsDays": [7, 28, 90],
    "rule": "Every impact claim must name the pre/post window and the relevant annotation."
  },
